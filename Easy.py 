# --- 3. スマホ画面（GUI）の構築 ---
root = tk.Tk()
root.title("My Ultra Language App")
root.geometry("400x600")

APP_FONT = ("Helvetica", 12)

def on_language_change(event=None):
    lang = lang_combo.get()
    text = LANG_TEXTS[lang]
    label_code.config(text=text["label"])
    btn_run.config(text=text["btn"])
    label_out.config(text=text["output"])
    label_hint.config(text=text["hint"])
    
    code_entry.delete("1.0", tk.END)
    code_entry.insert("1.0", text["sample"])

frame_top = tk.Frame(root)
frame_top.pack(fill="x", padx=10, pady=5)

lang_combo = ttk.Combobox(frame_top, values=list(LANG_TEXTS.keys()), state="readonly", width=10, font=APP_FONT)
lang_combo.set("日本語")
lang_combo.pack(side="left")
lang_combo.bind("<<ComboboxSelected>>", on_language_change)

# 📊 文字化け対策：フォントサイズを微調整して確実に収まるように設定
label_hint = tk.Label(frame_top, text="", fg="blue", font=("Helvetica", 9, "bold"))
label_hint.pack(side="left", padx=5)

label_code = tk.Label(root, text="", anchor="w", font=APP_FONT)
label_code.pack(fill="x", padx=10, pady=(10, 2))
code_entry = tk.Text(root, height=10, font=APP_FONT)
code_entry.pack(fill="both", expand=True, padx=10, pady=2)

def press_run():
    user_code = code_entry.get("1.0", tk.END)
    result = run_my_language(user_code)
    
    output_display.config(state="normal")
    if result == "CLEAR_SIGNAL":
        output_display.delete("1.0", tk.END)
    else:
        output_display.delete("1.0", tk.END)
        output_display.insert("1.0", str(result))
    output_display.config(state="disabled")

btn_run = tk.Button(root, text="", bg="#28a745", fg="white", font=("Helvetica", 14, "bold"), command=press_run)
btn_run.pack(fill="x", padx=10, pady=10)

label_out = tk.Label(root, text="", anchor="w", font=APP_FONT)
label_out.pack(fill="x", padx=10, pady=(10, 2))
output_display = tk.Text(root, height=8, bg="#f0f0f0", font=APP_FONT, state="disabled")
output_display.pack(fill="both", expand=True, padx=10, pady=(2, 10))

on_language_change()
root.mainloop()
